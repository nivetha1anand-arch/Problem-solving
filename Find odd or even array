def findevenodd(array):
    print(array)
    odd=[]
    even=[]
    for i in array:
        if i%2 == 0:
            even.append(i)
        else:
            odd.append(i)
    print(odd)
    print(even)
    result={}
    result["odd"]=odd
    result["even"]=even
    return result
