#3.count character frequency-------------------------------------------------------
s = "hello world I am Nivetha Anandhakannans daughter"
char_freq = {}
for char in s:
    if char in char_freq:
        char_freq[char] += 1
    else:
        char_freq[char] = 1
print(char_freq)

#3. printing same output in table format-----------------------------------------
s = "hello world I am Nivetha Anandhakannans daughter"
dic = {}
for i in s:
    if i in dic:
        dic[i] += 1
    else:
        dic[i] = 1

print("Character\tFrequency")
print("--------------------")
for char, freq in dic.items():
    print(f"{char}\t\t{freq}") 
    
