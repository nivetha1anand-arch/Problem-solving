from selenium import webdriver

# Open Chrome
driver = webdriver.Chrome()

# Open Google
driver.get("https://www.google.com")

# Maximize the browser
driver.maximize_window()

# Wait for 5 seconds
import time
time.sleep(5)

# Refresh the page
driver.refresh()

time.sleep(2)

# Go to YouTube
driver.get("https://www.youtube.com")

time.sleep(2)

# Go back
driver.back()

time.sleep(2)

# Go forward
driver.forward()

time.sleep(2)

# Close the browser
driver.quit()
